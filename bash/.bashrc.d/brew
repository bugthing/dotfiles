# handle which postgres in brew we point at
BREW_POSTGRES_VERSION="16"
export PATH="$HOMEBREW_PREFIX/opt/postgresql@$BREW_POSTGRES_VERSION/bin:$PATH"
export LDFLAGS="-L$HOMEBREW_PREFIX/opt/postgresql@$BREW_POSTGRES_VERSION/lib"
export CPPFLAGS="-I$HOMEBREW_PREFIX/opt/postgresql@$BREW_POSTGRES_VERSION/include"
export PKG_CONFIG_PATH="$HOMEBREW_PREFIX/opt/postgresql@$BREW_POSTGRES_VERSION/lib/pkgconfig"


